---
import Base from '../layouts/Base.astro';
import SearchField from '../components/SearchField.astro';
import OlderReleases from '../components/OlderReleases.astro';
import StartLinks from '../components/StartLinks.astro';
import StartText from '../components/StartText.astro';
import { directionOf } from '@openfolia/content-model';
import { textsFor } from '../lib/i18n.ts';
import { sectionId } from '../lib/start.ts';
import { authoredStart, catalogue, entryPath, formatDate, href, manualPath, siteBrand } from '../lib/site.ts';

const { s, cards } = catalogue();
const t = textsFor(s.lang);
const brand = siteBrand();
const title = brand.name ?? t.siteTitle;
// The authored start page (#897): its heading and introduction, its text and its featured links;
// without one, the page is the default one.
const start = authoredStart();
const intro = start?.sections[0];
/** What stands under the search field: the first section only with more than its heading and lead. */
const sections = start?.sections.filter((section) => section.text.length > 0 || section.links.length > 0) ?? [];
/** A section's language and direction where they are not the site's: its translation is missing. */
const other = (lang: string) => (start && lang !== s.lang ? { lang, dir: directionOf(start.resolved, lang) } : {});
/** Manuals a product shows on the start page; the rest are a link to the list away. */
const SHOWN = 6;
/** Variants a manual links before "+n more" (the manual's own page has them all). */
const FOLD = 4;
---

<Base title={title} current="start">
  <div class="start">
    <section class="start__lead" id={intro && sectionId(intro.module)}>
      {
        start && intro ? (
          <>
            <h1 class:list={['start__title', { 'start__title--long': intro.title.length > 32, 'start__title--longest': intro.title.length > 72 }]} {...other(intro.lang)}>{intro.title}</h1>
            {intro.lead.length > 0 && <StartText page={start} section={intro} part="lead" />}
          </>
        ) : (
          <>
            <h1 class="start__title">{title}</h1>
            <p class="start__intro">{t.startIntro}</p>
          </>
        )
      }
      <SearchField id="start-q" size="large" />
    </section>
    {
      start && sections.length > 0 && (
        <div class="start__authored">
          {sections.map((section, i) => {
            const heading = section === intro ? undefined : `start-h-${i}`;
            return (
              <section class="start__section" id={section === intro ? undefined : sectionId(section.module)} aria-labelledby={heading}>
                {heading && <h2 class="start__heading" id={heading} {...other(section.lang)}>{section.title}</h2>}
                {section.text.length > 0 && <StartText page={start} section={section} part="text" />}
                {section.links.length > 0 && <StartLinks links={section.links} labelledBy={heading} page={start} {...other(section.lang)} />}
              </section>
            );
          })}
        </div>
      )
    }
    {cards.length === 0 && <p class="empty empty--page">{t.noManuals}</p>}
    {
      s.releases.map((release) => (
        <section class="product" id={`product-${release.product}`} data-product-section={release.product} aria-labelledby={`h-${release.product}`}>
          <header class="product__head">
            <h2 class="product__name" id={`h-${release.product}`}>{release.productLabel}</h2>
            <p class="product__release">
              {t.latestRelease} {release.revision}
              <span class="sep" aria-hidden="true">·</span>
              <time datetime={release.publishedAt}>{formatDate(release.publishedAt, s.lang)}</time>
            </p>
            <OlderReleases release={release} />
          </header>
          <ul class="entries">
            {release.manuals.slice(0, SHOWN).map((manual) => (
              <li class="entry">
                <a class="entry__title" href={href(entryPath(release, manual))}>{manual.title}</a>
                {manual.guide && <span class="kind-tag">{t.updateGuide}</span>}
                {!manual.guide && manual.variants.length > 1 && (
                  <ul class="entry__variants" aria-label={t.variants}>
                    {manual.variants.slice(0, FOLD).map((v) => (
                      <li><a href={href(manualPath(release, manual, v))}>{v.label}</a></li>
                    ))}
                    {manual.variants.length > FOLD && (
                      <li class="entry__more">
                        <a href={href(manualPath(release, manual, manual.variants[FOLD]!))}>{t.moreVariants.replace('{n}', String(manual.variants.length - FOLD))}</a>
                      </li>
                    )}
                  </ul>
                )}
              </li>
            ))}
          </ul>
          {release.manuals.length > SHOWN && (
            <p class="product__more">
              <a class="arrow-link" href={href(`manuals/?product=${release.product}`)}>
                {t.allOfProduct.replace('{n}', String(release.manuals.length)).replace('{product}', () => release.productLabel)}
                <span aria-hidden="true">→</span>
              </a>
            </p>
          )}
        </section>
      ))
    }
  </div>
</Base>
