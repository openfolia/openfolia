---
import ManualView from '../../../../components/ManualView.astro';
import { manualPages, type ManualPage } from '../../../../lib/site.ts';

// A manual page of a product's newest release: the address readers have always used.
export function getStaticPaths() {
  return manualPages().map((page) => ({
    params: {
      product: page.release.product,
      manual: page.manual.id,
      variant: page.variant.slug,
    },
    props: { page },
  }));
}

const { page } = Astro.props as { page: ManualPage };
---

<ManualView page={page} />
