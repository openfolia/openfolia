---
import GuideView from '../../../components/GuideView.astro';
import { guidePages, type GuidePage } from '../../../lib/site.ts';

// An update guide's page (#907) of a product's newest release.
export function getStaticPaths() {
  return guidePages().map((page) => ({
    params: { product: page.release.product, manual: page.manual.id },
    props: { page },
  }));
}

const { page } = Astro.props as { page: GuidePage };
---

<GuideView page={page} />
