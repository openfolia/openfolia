---
import { textsFor } from '../lib/i18n.ts';
import { href, snapshot } from '../lib/site.ts';
import { directionOf } from '@openfolia/content-model';
import type { StartLink, StartLinkKind, StartPage } from '../lib/start.ts';

interface Props {
  links: readonly StartLink[];
  /** The ID of the heading they stand under; none: the list names itself. */
  labelledBy?: string | undefined;
  /** The links' language where it is not the site's (a missing translation). */
  lang?: string | undefined;
  dir?: 'ltr' | 'rtl' | undefined;
  page: StartPage;
}

/**
 * The authored start page's featured links (#897) as index cards: the title, its line, and at the
 * foot where it leads. Links the build has no page for never reach it (`src/lib/start.ts`).
 */
const { links, labelledBy, lang, dir, page } = Astro.props;
const s = snapshot();
const t = textsFor(s.lang);
/** A title in another language than its card: its target's, where that is translated and this section is not. */
const titleLang = (link: StartLink) =>
  link.lang === (lang ?? s.lang) ? {} : { lang: link.lang, dir: directionOf(page.resolved, link.lang) };
/**
 * Three or four cards a row, whichever leaves the last row fuller; one or two stay a pair's
 * width, and long titles or lines get at most three a row, so no card stands tall beside a short one.
 */
const n = links.length;
const fill = (columns: number) => (n % columns || columns) / columns;
const long = links.some((link) => link.title.length > 60 || link.text.length > 110);
const columns = n <= 2 ? 2 : long ? (n % 3 === 0 ? 3 : 2) : fill(3) >= fill(4) ? 3 : 4;
const foot = (link: StartLink) =>
  link.kind === 'search' ? t.search : link.kind === 'list' && link.context === '' ? t.manuals : link.context;
const ICONS: Record<StartLinkKind, string> = {
  manual: 'M12 6.5C10 5 7.5 4.5 4 4.5v13c3.5 0 6 .5 8 2 2-1.5 4.5-2 8-2v-13c-3.5 0-6 .5-8 2zm0 0v13',
  section: 'M6 3.5h8l4 4v13H6zM9 11.5h6M9 15h6',
  list: 'M4.5 6.5h15M4.5 12h15M4.5 17.5h15',
  search: 'M11 4.5a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13zm5 11.5 4 4',
  release: 'M12 3.5a8.5 8.5 0 1 1 0 17 8.5 8.5 0 0 1 0-17zM12 7.5V12l3 2',
  external: 'M6 18 18 6M8.5 6H18v9.5',
};
---

<ul class="start-links" data-columns={columns} aria-label={labelledBy ? undefined : t.featuredLinks} aria-labelledby={labelledBy} lang={lang} dir={dir}>
  {
    links.map((link) => (
      <li class="start-links__item">
        <a class="start-card" href={link.kind === 'external' ? link.to : href(link.to)} rel={link.kind === 'external' ? 'external noopener noreferrer' : undefined}>
          <span class="start-card__title" {...titleLang(link)}>{link.title}</span>
          {link.text !== '' && <span class="start-card__text">{link.text}</span>}
          <span class="start-card__foot" lang={lang && s.lang} dir={lang && s.dir}>
            <svg class="start-card__icon" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><path d={ICONS[link.kind]} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            {link.guide && <span class="kind-tag">{t.updateGuide}</span>}
            <span class="start-card__context">
              {link.kind === 'external' && <span class="visually-hidden">{t.externalLink}: </span>}
              {foot(link)}
            </span>
          </span>
        </a>
      </li>
    ))
  }
</ul>
