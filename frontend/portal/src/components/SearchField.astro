---
import { textsFor } from '../lib/i18n.ts';
import { href, snapshot } from '../lib/site.ts';

interface Props {
  id: string;
  size?: 'large' | 'page';
  /** Inside the search page's own form: no form of its own. */
  bare?: boolean;
}

/** The large search field (#784): the start page's, the 404's and the search page's. */
const { id, size = 'large', bare = false } = Astro.props;
const t = textsFor(snapshot().lang);
---

{
  bare ? (
    <div class:list={['bigsearch', `bigsearch--${size}`]}>
      <label class="visually-hidden" for={id}>{t.searchLabel}</label>
      <svg class="bigsearch__icon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.75"></circle><path d="m16 16 4 4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path></svg>
      <input id={id} name="q" type="search" placeholder={t.searchPlaceholder} data-placeholder-short={t.searchShort} autocomplete="off" enterkeyhint="search" />
      <button type="submit">
        <span class="bigsearch__label">{t.searchButton}</span>
        <svg class="bigsearch__go" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
    </div>
  ) : (
    <form class:list={['bigsearch', `bigsearch--${size}`]} action={href('search/')} method="get" role="search">
      <label class="visually-hidden" for={id}>{t.searchLabel}</label>
      <svg class="bigsearch__icon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.75"></circle><path d="m16 16 4 4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path></svg>
      <input id={id} name="q" type="search" placeholder={t.searchPlaceholder} data-placeholder-short={t.searchShort} autocomplete="off" enterkeyhint="search" />
      <button type="submit">
        <span class="bigsearch__label">{t.searchButton}</span>
        <svg class="bigsearch__go" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
    </form>
  )
}
