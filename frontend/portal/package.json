{
  "name": "@openfolia/portal",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "dependencies": {
    "@openfolia/content-model": "workspace:*",
    "@openfolia/render-html": "workspace:*",
    "@openfolia/theme": "workspace:*",
    "astro": "7.4.7",
    "pagefind": "1.6.0",
    "sharp": "0.34.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@axe-core/playwright": "4.14.0",
    "@openfolia/content-repo": "workspace:*",
    "@playwright/test": "1.65.0",
    "typescript": "^6.0.3"
  },
  "nx": {
    "name": "portal",
    "projectType": "application",
    "tags": [
      "scope:frontend",
      "type:portal"
    ],
    "implicitDependencies": [
      "api"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "cache": true,
        "inputs": [
          "production",
          "{workspaceRoot}/frontend/theme/**/*",
          {
            "dependentTasksOutputFiles": "**/*",
            "transitive": true
          },
          "{workspaceRoot}/backend/api/scripts/in-process-api.mjs",
          "{workspaceRoot}/backend/sandbox/src/database.ts",
          "{workspaceRoot}/pnpm-lock.yaml"
        ],
        "outputs": [
          "{projectRoot}/dist-fixture"
        ],
        "options": {
          "cwd": "frontend/portal",
          "command": "node scripts/build-fixture.ts"
        }
      },
      "site": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "cache": false,
        "options": {
          "cwd": "frontend/portal",
          "command": "node scripts/build.ts"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/pnpm-lock.yaml"
        ],
        "options": {
          "cwd": "frontend/portal",
          "commands": [
            "astro check --root . --tsconfig tsconfig.app.json",
            "tsc --noEmit -p tsconfig.node.json"
          ],
          "parallel": false
        }
      },
      "test": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/backend/api/scripts/in-process-api.mjs",
          "{workspaceRoot}/backend/sandbox/src/database.ts",
          "{workspaceRoot}/.env.example"
        ]
      },
      "browsers": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "{projectRoot}",
          "command": "node node_modules/@playwright/test/cli.js install --only-shell chromium"
        }
      },
      "e2e": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "browsers",
          "build"
        ],
        "cache": true,
        "inputs": [
          "{projectRoot}/e2e/**/*",
          {
            "dependentTasksOutputFiles": "**/*"
          },
          "{workspaceRoot}/pnpm-lock.yaml",
          {
            "env": "E2E_WORKERS"
          }
        ],
        "outputs": [],
        "options": {
          "cwd": "{projectRoot}",
          "command": "node node_modules/@playwright/test/cli.js test --config e2e/playwright.config.ts"
        }
      }
    }
  }
}
