{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../packages/xliff/tsconfig.lib.json"
    },
    {
      "path": "../../frontend/theme"
    },
    {
      "path": "../../packages/render-typst/tsconfig.lib.json"
    },
    {
      "path": "../../packages/render-html/tsconfig.lib.json"
    },
    {
      "path": "../../packages/dita/tsconfig.lib.json"
    },
    {
      "path": "../../packages/xml/tsconfig.lib.json"
    },
    {
      "path": "../../packages/content-repo/tsconfig.lib.json"
    },
    {
      "path": "../../packages/content-model/tsconfig.lib.json"
    },
    {
      "path": "../mcp/tsconfig.lib.json"
    },
    {
      "path": "../../connectors/tracker/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx"
  ]
}
