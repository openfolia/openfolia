# Angular build cache
.angular/
# The iiRDS validator rules the API tests fetch (backend/api/tests/iirds/fetch-validator.ts)
backend/api/.cache/
# The OASIS DITA grammar files the DITA tests fetch (packages/dita/src/testing/fetch-grammars.ts)
packages/dita/.cache/

# A deployment's own files beside deploy/compose.yaml (settings with secrets, backups):
# never in a build context or a commit (deploy/README.md).
deploy/api.env
deploy/worker.env
deploy/*.env
deploy/backups/
# The embedding worker's model files (deploy/compose.embedder.yaml): fetched by whoever deploys, never committed.
deploy/embedder-model/
*.dump

# The demo set-up for the films (scripts/demo/, docs/demo-videos.md): runs, log, state
.demo/
