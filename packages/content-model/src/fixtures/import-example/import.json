          "blocks": [
            {
              "type": "paragraph",
              "id": "warn-overpressure-text",
              "content": [
                {
                  "type": "text",
                  "text": "Never fill the tank above the maximum pressure."
                }
              ]
            }
          ]
        },
        { "type": "moduleRef", "id": "ref-limits", "module": "pressure-limits" }
      ]
    },
