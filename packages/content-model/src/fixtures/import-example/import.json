                {
                  "type": "text",
                  "text": "Connect the hose to the tank inlet."
                }
              ],
              "blocks": [
                {
                  "type": "image",
                  "id": "fig-connect",
                  "asset": "sha256:497790947d4666760ce38f3c00e852c71fdb66cae849bae8e9ede352719e1581",
                  "alt": "The hose connected to the tank inlet",
                  "width": 50
                }
              ]
            },
            {
              "id": "step-start",
              "content": [
                { "type": "text", "text": "Press " },
                { "type": "kbd", "keys": ["Start"] },
                {
                  "type": "text",
                  "text": " until the gauge shows the set pressure."
                }
              ],
              "blocks": []
            }
          ]
        },
        {
          "type": "safety",
          "id": "warn-overpressure",
          "severity": "warning",
          "hazard": [{ "type": "text", "text": "Overpressure" }],
