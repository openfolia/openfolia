// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderManualHtml > renders the fixture manual (snapshot) 1`] = `
"<article class="of-content of-manual" lang="en" dir="ltr"><header class="of-manual__header"><h1 class="of-manual__title">Operating manual</h1><p class="of-manual__subtitle">Large · EU</p></header><nav class="of-toc" aria-label="Contents"><h2 class="of-toc__title">Contents</h2><ol class="of-toc__list"><li class="of-toc__item of-toc__item--group"><span class="of-toc__group">Getting started</span><ol class="of-toc__list"><li class="of-toc__item"><a class="of-toc__link" href="#of-basics">Basics</a></li></ol></li><li class="of-toc__item"><a class="of-toc__link" href="#of-charging">Charging the battery</a></li><li class="of-toc__item"><a class="of-toc__link" href="#of-_glossary">Glossary</a></li></ol></nav><section class="of-group"><h2 class="of-group__title">Getting started</h2><section class="of-module" id="of-basics"><h3 class="of-module__title" id="of-_h-basics">Basics</h3><section class="of-section" id="of-basics--lights"><h4 class="of-section__title" id="of-_h-basics--lights">Status lights</h4><p class="of-paragraph" id="of-basics--p">They blink.</p><p class="of-paragraph" id="of-charging-note--only">Inlined from another module.</p><section class="of-section" id="of-basics--deeper"><h5 class="of-section__title" id="of-_h-basics--deeper">Blink codes</h5><p class="of-paragraph" id="of-basics--codes">Fast blinking means a fault.</p></section></section></section></section><section class="of-module" id="of-charging"><h2 class="of-module__title" id="of-_h-charging">Charging the battery</h2><p class="of-paragraph" id="of-charging--intro">The Model A charges itself. Press <kbd class="of-kbd"><kbd class="of-kbd__key">Ctrl</kbd><span class="of-kbd__separator">+</span><kbd class="of-kbd__key">S</kbd></kbd>, tap <span class="of-ui">Park</span>, see <a class="of-xref" href="#of-basics--lights">Status lights</a> or <a class="of-link" href="https://example.com/help?a=1&amp;b=2" rel="noopener noreferrer"><strong>the website</strong></a>. The socket <a class="of-callout-ref" href="#of-charging--photo" data-callout="charging--photo:socket">3</a> and the fan <a class="of-callout-ref" href="#of-charging--photo" data-callout="charging--photo:fan">1</a>.<br><em>H</em><sub>2</sub>O and m<sup>2</sup> with <code class="of-code">config.yaml</code>. Back to <a class="of-xref" href="#of-basics"><em>the basics</em></a>.</p><p class="of-paragraph" id="of-charging--terms">Plug the <span class="of-term"><a class="of-term__link" href="#of-_term-charger" aria-describedby="of-_term-tip-1">charger</a><span class="of-term__definition" role="tooltip" id="of-_term-tip-1">The device that charges the <strong>battery</strong> &lt;safely&gt;.</span></span> into the <span class="of-term"><a class="of-term__link" href="#of-_term-socket" aria-describedby="of-_term-tip-2">charging <strong>socket</strong></a><span class="of-term__definition" role="tooltip" id="of-_term-tip-2">Where the cable plugs in.</span></span>, not the <span class="of-term of-term--unresolved">dock</span>.</p><div class="of-safety of-safety--warning" role="note" id="of-charging--hot"><p class="of-safety__signal">WARNING</p><div class="of-safety__body"><div class="of-safety__symbols"><img class="of-safety__symbol" src="/symbols/w001.svg" alt="General warning"></div><div class="of-safety__content"><p class="of-safety__hazard">Hot surface</p><p class="of-paragraph" id="of-charging--hot-p">Let it cool down.</p></div></div></div><div class="of-procedure" id="of-charging--steps"><p class="of-procedure__title">Charge manually</p><ol class="of-procedure__steps" role="list"><li class="of-procedure__step" id="of-charging--s1"><p class="of-item__text">Park the vehicle.</p></li><li class="of-procedure__step" id="of-charging--s2"><p class="of-item__text">Connect the cable.</p><ul class="of-list of-list--unordered" id="of-charging--l"><li class="of-list__item" id="of-charging--l1"><p class="of-item__text">Red to +</p></li></ul></li></ol></div><ol class="of-list of-list--ordered" id="of-charging--checks"><li class="of-list__item" id="of-charging--c1"><p class="of-item__text">Check the cable.</p></li></ol><p class="of-paragraph" id="of-charging--large-only">Large models also show the charge in the app.</p><div class="of-table" id="of-charging--t"><table class="of-table__table"><caption class="of-caption"><span class="of-caption__label">Table 1:</span> Status lights</caption><colgroup><col style="width:25%"><col style="width:75%"></colgroup><thead><tr><th class="of-table__cell" scope="col"><p class="of-paragraph" id="of-charging--h1">Light</p></th><th class="of-table__cell of-table__cell--right" scope="col"><p class="of-paragraph" id="of-charging--h2">Meaning</p></th></tr></thead><tbody><tr><td class="of-table__cell" rowspan="2"><p class="of-paragraph" id="of-charging--r1">Green</p></td><td class="of-table__cell of-table__cell--right"><p class="of-paragraph" id="of-charging--r1b">Ready</p></td></tr><tr><td class="of-table__cell of-table__cell--right"><p class="of-paragraph" id="of-charging--r2">Charging</p></td></tr><tr><td class="of-table__cell" colspan="2"><p class="of-paragraph" id="of-charging--r3">Off: no power</p></td></tr></tbody></table></div><figure class="of-figure" id="of-charging--photo"><div class="of-callouts of-callouts--below"><div class="of-callouts__picture" style="width:50%"><img class="of-figure__image" src="/assets/abababababababababababababababababababababababababababababababab" alt="The charger, front view" loading="lazy" decoding="async"><svg class="of-callouts__overlay" width="100%" height="100%" aria-hidden="true" focusable="false"><line class="of-callouts__leader" data-callout="charging--photo:fan" x1="60.00%" y1="50.00%" x2="85.00%" y2="10.00%"></line><circle class="of-callouts__anchor" data-callout="charging--photo:fan" cx="60.00%" cy="50.00%" r="2.5"></circle><g class="of-callouts__marker" data-callout="charging--photo:fan" data-callout-style="square"><circle cx="85.00%" cy="10.00%" r="10"></circle><text x="85.00%" y="10.00%" text-anchor="middle" dominant-baseline="central">1</text></g><g class="of-callouts__marker" data-callout="charging--photo:switch"><circle cx="20.00%" cy="30.00%" r="10"></circle><text x="20.00%" y="30.00%" text-anchor="middle" dominant-baseline="central">2</text></g><g class="of-callouts__marker" data-callout="charging--photo:socket"><circle cx="50.00%" cy="90.00%" r="10"></circle><text x="50.00%" y="90.00%" text-anchor="middle" dominant-baseline="central">3</text></g></svg></div><ol class="of-callouts__legend" role="list"><li class="of-callouts__entry" data-callout="charging--photo:fan"><span class="of-callout-number">1</span> <span class="of-callouts__text">Fan, <strong>large model</strong></span></li><li class="of-callouts__entry" data-callout="charging--photo:switch"><span class="of-callout-number">2</span> <span class="of-callouts__text">Power switch</span></li><li class="of-callouts__entry" data-callout="charging--photo:socket"><span class="of-callout-number">3</span> <span class="of-callouts__text">Socket</span></li></ol></div><figcaption class="of-caption"><span class="of-caption__label">Figure 1:</span> The charger</figcaption></figure><div class="of-image" id="of-charging--plain-photo"><div class="of-callouts of-callouts--beside"><div class="of-callouts__picture"><img class="of-figure__image" src="/assets/abababababababababababababababababababababababababababababababab" alt="The plug" loading="lazy" decoding="async"><svg class="of-callouts__overlay" width="100%" height="100%" aria-hidden="true" focusable="false"><g class="of-callouts__marker" data-callout="charging--plain-photo:pins"><circle cx="50.00%" cy="50.00%" r="10"></circle><text x="50.00%" y="50.00%" text-anchor="middle" dominant-baseline="central">1</text></g></svg></div><ol class="of-callouts__legend" role="list"><li class="of-callouts__entry" data-callout="charging--plain-photo:pins"><span class="of-callout-number">1</span> <span class="of-callouts__text">Pins</span></li></ol></div></div><div class="of-admonition of-admonition--tip" role="note" id="of-charging--n"><p class="of-admonition__label">Tip</p><p class="of-paragraph" id="of-charging--n1">Charge overnight.</p></div><details class="of-faq" id="of-charging--faq-overnight"><summary class="of-faq__question">Can I charge overnight?</summary><div class="of-faq__answer"><p class="of-paragraph" id="of-charging--faq-overnight-a">Yes: the charger stops when full.</p></div></details><pre class="of-literal" id="of-charging--code" data-language="sh"><code>echo &quot;&lt;hi&gt;&quot; &amp; exit
  done</code></pre><div class="of-unconverted" role="note" id="of-charging--raw"><p class="of-unconverted__label">Unconverted content <span class="of-unconverted__format">(html)</span></p><pre class="of-unconverted__source"><code>&lt;b onclick=&quot;x()&quot;&gt;legacy&lt;/b&gt;</code></pre></div></section><section class="of-glossary" id="of-_glossary"><h2 class="of-glossary__title" id="of-_h-_glossary">Glossary</h2><dl class="of-glossary__list"><div class="of-glossary__entry" id="of-_term-charger"><dt class="of-glossary__term"><dfn>charger</dfn></dt> <dd class="of-glossary__definition">The device that charges the <strong>battery</strong> &lt;safely&gt;.</dd></div><div class="of-glossary__entry" id="of-_term-socket"><dt class="of-glossary__term"><dfn>charging socket</dfn></dt> <dd class="of-glossary__definition">Where the cable plugs in.</dd></div></dl></section></article>"
`;
