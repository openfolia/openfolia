<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="specs" xml:lang="de" audience="technician">
  <title>Technische Daten</title>
  <refbody>
    <properties id="data">
      <prophead>
        <proptypehd>Eigenschaft</proptypehd>
        <propvaluehd>Wert</propvaluehd>
      </prophead>
      <property>
        <proptype>Förderleistung</proptype>
        <propvalue>2.000 l/h</propvalue>
      </property>
      <property>
        <proptype>Leistung</proptype>
        <propvalue>300 W</propvalue>
      </property>
    </properties>
    <table id="models">
      <title>Modelle</title>
      <tgroup cols="3">
        <colspec colname="c1" colwidth="2*"/>
        <colspec colname="c2" colwidth="1*"/>
        <colspec colname="c3" colwidth="1*"/>
        <thead>
          <row>
            <entry>Modell</entry>
            <entry>Förderleistung</entry>
            <entry>Timer</entry>
          </row>
        </thead>
        <tbody>
          <row>
            <entry>Basic</entry>
            <entry morerows="1">2.000 l/h</entry>
            <entry>Nein</entry>
          </row>
          <row>
            <entry>Pro</entry>
            <entry>Ja</entry>
          </row>
          <row>
            <entry namest="c1" nameend="c3">Beide laufen mit 230 V.</entry>
          </row>
        </tbody>
      </tgroup>
    </table>
  </refbody>
</reference>
