<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="specs" xml:lang="en" audience="technician">
  <title>Technical data</title>
  <refbody>
    <properties id="data">
      <prophead>
        <proptypehd>Property</proptypehd>
        <propvaluehd>Value</propvaluehd>
      </prophead>
      <property>
        <proptype>Flow</proptype>
        <propvalue>2,000 l/h</propvalue>
      </property>
      <property>
        <proptype>Power</proptype>
        <propvalue>300 W</propvalue>
      </property>
    </properties>
    <table id="models">
      <title>Models</title>
      <tgroup cols="3">
        <colspec colname="c1" colwidth="2*"/>
        <colspec colname="c2" colwidth="1*"/>
        <colspec colname="c3" colwidth="1*"/>
        <thead>
          <row>
            <entry>Model</entry>
            <entry>Flow</entry>
            <entry>Timer</entry>
          </row>
        </thead>
        <tbody>
          <row>
            <entry>Basic</entry>
            <entry morerows="1">2,000 l/h</entry>
            <entry>No</entry>
          </row>
          <row>
            <entry>Pro</entry>
            <entry>Yes</entry>
          </row>
          <row>
            <entry namest="c1" nameend="c3">Both run on 230 V.</entry>
          </row>
        </tbody>
      </tgroup>
    </table>
  </refbody>
</reference>
